# Server-side only. Never use NEXT_PUBLIC_ for these values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opt-in: logs full prompts, schemas, resume/job content and raw AI output.
# Keep false outside active debugging. Server credentials are always redacted.
AI_DEBUG_LOG_PAYLOADS=false

# Required for public Vercel deployments. Production fails closed without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A long random secret, used to HMAC client IPs before storing rate-limit counters.
RATE_LIMIT_SALT=
